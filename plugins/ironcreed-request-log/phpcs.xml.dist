<?xml version="1.0"?>
<ruleset name="IRONCREED Request Log">
 <config name="testVersion" value="8.0-"/>
 <file>ironcreed-request-log.php</file><file>uninstall.php</file><file>includes</file>
 <exclude-pattern>vendor/*</exclude-pattern>
 <arg name="extensions" value="php"/><arg value="ps"/>
 <rule ref="WordPress-Core"/><rule ref="WordPress-Docs"/><rule ref="WordPress-Extra"/>
 <rule ref="PHPCompatibilityWP"/>
</ruleset>
