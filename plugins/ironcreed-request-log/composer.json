{
  "name": "ironcreed/request-log",
  "description": "Development tools for IRONCREED Request Log.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "phpunit/phpunit": "9.6.33",
    "wp-coding-standards/wpcs": "3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.0.0"
    }
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist",
    "test": "phpunit -c phpunit.xml.dist",
    "package-check": "php tests/package-check.php",
    "check": "php ../../constitutional-guard/run.php all",
    "build": "bash tools/build.sh"
  }
}
